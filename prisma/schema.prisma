// UyBor Toshkent — ma'lumotlar bazasi sxemasi
// Pul: narx asl valyutada (price + currency) va filtr/saralash uchun USD'da (priceUsd) saqlanadi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enumlar ───────────────────────────

enum Role {
  BUYER // xaridor
  OWNER // sotuvchi (egasi)
  AGENT // agent / rieltor
  ADMIN
}

enum PropertyType {
  APARTMENT // kvartira
  HOUSE // hovli
  DUPLEX // dupleks
  NEW_BUILD // yangi qurilish (novostroyka)
}

enum Condition {
  RENOVATED // ta'mirli
  NO_RENOVATION // ta'mirsiz
  EURO // evroremont
  SHELL // qora suvoq (korobka)
}

enum ListingStatus {
  DRAFT // qoralama (forma to'ldirilmoqda)
  PENDING // moderatsiyada
  ACTIVE // faol
  REJECTED // rad etilgan
  SOLD // sotilgan
  ARCHIVED // arxivlangan
}

enum Currency {
  USD
  UZS
}

enum Locale {
  uz
  ru
  en
}

enum NotifyChannel {
  NONE
  TELEGRAM
  SMS
}

enum PaymentProvider {
  CLICK
  PAYME
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PromotionType {
  TOP // ro'yxat boshida ko'rsatish
  PREMIUM // ajratib ko'rsatish + TOP
  BUMP // bir martalik yuqoriga ko'tarish
}

enum ReportReason {
  FAKE // soxta e'lon
  WRONG_PRICE // narx noto'g'ri
  ALREADY_SOLD // allaqachon sotilgan
  DUPLICATE // takroriy
  FRAUD // firibgarlik
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum PoiType {
  METRO
  SCHOOL
  KINDERGARTEN
  BAZAAR
  HOSPITAL
  PARK
  MALL
}

// ─────────────────────── Foydalanuvchilar ───────────────────────

model User {
  id             String   @id @default(cuid())
  phone          String   @unique // +998XXXXXXXXX (E.164)
  name           String?
  role           Role     @default(BUYER)
  avatarUrl      String?
  locale         Locale   @default(uz)
  telegramChatId String? // Telegram xabarnomalari uchun
  telegramUser   String? // "Telegramda yozish" tugmasi uchun @username
  // Agent profili
  agencyName     String?
  bio            String?
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  isVerified     Boolean  @default(false)
  isBlocked      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions        Session[]
  listings        Listing[]      @relation("ListingOwner")
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  buyerChats      Conversation[] @relation("ChatBuyer")
  sellerChats     Conversation[] @relation("ChatSeller")
  messages        Message[]
  payments        Payment[]
  reports         Report[]       @relation("ReportAuthor")
  reportsResolved Report[]       @relation("ReportResolver")
  reviewsGiven    AgentReview[]  @relation("ReviewAuthor")
  reviewsReceived AgentReview[]  @relation("ReviewAgent")
  compareItems    CompareItem[]
}

/// SMS orqali kirish kodi (kodning o'zi emas, hash saqlanadi)
model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────── Geografiya ───────────────────────

model District {
  id           Int    @id @default(autoincrement())
  slug         String @unique // chilonzor, yunusobod...
  nameUz       String
  nameRu       String
  nameEn       String
  lat          Float
  lng          Float
  /// tuman o'rtacha m² narxi (USD) — fon vazifasi bilan qayta hisoblanadi
  avgPriceM2   Float?
  listingCount Int    @default(0)

  listings Listing[]
  pois     Poi[]
}

/// Yaqin atrofdagi obyektlar: metro, maktab, bog'cha, bozor...
model Poi {
  id         Int     @id @default(autoincrement())
  type       PoiType
  nameUz     String
  nameRu     String
  nameEn     String
  line       String? // metro liniyasi: Chilonzor, O'zbekiston, Yunusobod, Halqa
  lat        Float
  lng        Float
  districtId Int?

  district   District? @relation(fields: [districtId], references: [id])
  nearestFor Listing[] @relation("NearestMetro")

  @@index([type])
  @@index([lat, lng])
}

// ─────────────────────── E'lonlar ───────────────────────

model Listing {
  id         String        @id @default(cuid())
  slug       String        @unique // SEO: 3-xonali-kvartira-chilonzor-xxxx
  ownerId    String
  districtId Int
  type       PropertyType
  status     ListingStatus @default(DRAFT)

  title       String
  description String?

  // Narx
  price      Decimal  @db.Decimal(16, 2) // asl valyutada
  currency   Currency @default(USD)
  priceUsd   Decimal  @db.Decimal(14, 2) // filtr va saralash uchun
  pricePerM2 Decimal? @db.Decimal(10, 2) // USD, avtomatik hisoblanadi
  negotiable Boolean  @default(false)

  // Xususiyatlar
  rooms       Int
  area        Decimal   @db.Decimal(8, 2) // umumiy maydon, m²
  livingArea  Decimal?  @db.Decimal(8, 2)
  kitchenArea Decimal?  @db.Decimal(8, 2)
  landArea    Decimal?  @db.Decimal(8, 2) // hovli uchun, sotix
  floor       Int?
  totalFloors Int?
  yearBuilt   Int?
  condition   Condition
  hasCadastre Boolean   @default(false) // kadastr hujjati bor
  mortgageOk  Boolean   @default(false) // ipotekaga mos
  furnished   Boolean   @default(false)
  hasBalcony  Boolean   @default(false)
  hasParking  Boolean   @default(false)
  developer   String? // yangi qurilish uchun quruvchi kompaniya
  completionQ String? // topshirish muddati, masalan "2027-Q2"

  // Manzil
  address        String // ko'cha va uy raqami
  mahalla        String?
  landmark       String? // mo'ljal
  lat            Float
  lng            Float
  nearestMetroId Int?
  metroDistanceM Int? // eng yaqin metrogacha masofa (metr)

  // Kontakt (e'lon bo'yicha, profil telefonidan farqli bo'lishi mumkin)
  contactName  String?
  contactPhone String
  telegramUser String?

  // Ko'tarish (premium / TOP)
  isTop        Boolean   @default(false)
  topUntil     DateTime?
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  bumpedAt     DateTime? // ro'yxatda saralash uchun: COALESCE(bumpedAt, publishedAt)

  // Statistika va moderatsiya
  viewCount      Int       @default(0)
  phoneViewCount Int       @default(0)
  favoriteCount  Int       @default(0)
  moderationNote String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner         User               @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  district      District           @relation(fields: [districtId], references: [id])
  nearestMetro  Poi?               @relation("NearestMetro", fields: [nearestMetroId], references: [id])
  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  payments      Payment[]
  reports       Report[]
  dailyStats    ListingStatDaily[]
  compareItems  CompareItem[]

  @@index([status, districtId, type])
  @@index([status, priceUsd])
  @@index([status, publishedAt(sort: Desc)])
  @@index([lat, lng])
  @@index([ownerId])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  url       String // WebP, S3-mos storage
  key       String? // storage ichidagi kalit (o'chirish uchun)
  width     Int?
  height    Int?
  blurData  String? // lazy-load uchun kichik base64 placeholder
  order     Int      @default(0)
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, order])
}

/// Sotuvchi statistikasi: kunlik ko'rishlar
model ListingStatDaily {
  listingId  String
  date       DateTime @db.Date
  views      Int      @default(0)
  phoneViews Int      @default(0)
  favorites  Int      @default(0)
  messages   Int      @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, date])
}

// ─────────────────────── Xaridor funksiyalari ───────────────────────

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

/// Solishtirish ro'yxati (3 tagacha)
model CompareItem {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model SavedSearch {
  id             String        @id @default(cuid())
  userId         String
  name           String
  filters        Json // { districts: [], type, priceMin, priceMax, rooms: [], ... }
  notifyChannel  NotifyChannel @default(TELEGRAM)
  lastNotifiedAt DateTime?
  lastSeenAt     DateTime      @default(now()) // shu vaqtdan keyingi e'lonlar "yangi" hisoblanadi
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────── Chat ───────────────────────

model Conversation {
  id            String   @id @default(cuid())
  listingId     String
  buyerId       String
  sellerId      String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User      @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("ChatSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─────────────────────── To'lov va moderatsiya ───────────────────────

model Payment {
  id            String          @id @default(cuid())
  userId        String
  listingId     String
  provider      PaymentProvider
  promotion     PromotionType
  days          Int             @default(7)
  amountUzs     Int // so'mda (Click/Payme so'mda ishlaydi)
  status        PaymentStatus   @default(PENDING)
  providerTxnId String?         @unique // Click click_trans_id / Payme transaction id
  meta          Json? // provayder javoblari (audit uchun)
  paidAt        DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
}

model Report {
  id           String       @id @default(cuid())
  listingId    String
  reporterId   String? // mehmon ham shikoyat qila oladi
  reason       ReportReason
  comment      String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User?   @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?   @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId])
}

/// Agent reytingi
model AgentReview {
  id        String   @id @default(cuid())
  agentId   String
  authorId  String
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  agent  User @relation("ReviewAgent", fields: [agentId], references: [id], onDelete: Cascade)
  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([agentId, authorId])
}

/// cbu.uz dan olingan USD→UZS kursi (kesh)
model ExchangeRate {
  id        Int      @id @default(autoincrement())
  currency  String // "USD"
  rate      Decimal  @db.Decimal(12, 2) // 1 USD = rate so'm
  date      DateTime @db.Date
  fetchedAt DateTime @default(now())

  @@unique([currency, date])
}
