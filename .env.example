# PostgreSQL (Neon). Pooled — ilova uchun, DIRECT — migratsiyalar uchun
DATABASE_URL="postgresql://user:pass@host-pooler/uybor?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/uybor?sslmode=require"

# Keyingi bosqichlarda kerak bo'ladi
# AUTH_SECRET=            # sessiya imzosi (openssl rand -base64 32)
# ESKIZ_EMAIL= / ESKIZ_PASSWORD=   # SMS (eskiz.uz)
# S3_ENDPOINT= / S3_BUCKET= / S3_ACCESS_KEY= / S3_SECRET_KEY=
# TELEGRAM_BOT_TOKEN=
# CLICK_SERVICE_ID= / CLICK_MERCHANT_ID= / CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID= / PAYME_KEY=
